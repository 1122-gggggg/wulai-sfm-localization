{
  "pipeline": "定位/mission",
  "paths_relative_to": "sfm_system",
  "entrypoint": "定位/mission/mission_pipeline.py",
  "operator_entrypoint": "定位/mission/operator_interface/flight_operator_app.py",
  "authoring": {
    "draw_path": "authoring/draw_path.py",
    "draw_poles": "authoring/draw_poles.py",
    "draw_wires": "authoring/draw_wires.py",
    "label_route": "authoring/label_route_points.py"
  },
  "flight_control": {
    "sdk": "Parrot Olympe Python SDK",
    "default_drone_ip": "192.168.42.1",
    "field_drone_ip": "192.168.53.1",
    "field_controller": "skycontroller3",
    "safety_file": "/tmp/sfm_drone_safety.cmd",
    "runtime_safety_modes": ["auto", "hover", "manual", "land"],
    "default_stream_size": "1280x720",
    "stream_lost_action": "hover",
    "stream_stale_seconds": 0.5,
    "firmware_limits": {
      "max_altitude_m": null,
      "max_distance_m": null,
      "distance_geofence_enabled": true,
      "min_takeoff_battery_percent": 30,
      "require_gps_for_distance_geofence": true,
      "unset_limit_policy": "ground UI allowed; takeoff blocked"
    },
    "flight_script": "flight_control/path_follow_flight.py",
    "default_bundle": "定位/bundles/current_reloc_map_updated_v3.pt",
    "default_megaloc_cache": null,
    "note": "The transfer package uses ref_global embedded in the current bundle; no external MegaLoc cache ships. Real flight requires complete ref_centers/ref_yaws/covis tracking metadata. Use SkyController 3 for field flights that require manual takeover."
  },
  "outputs": {
    "flight_path": "定位/mission/outputs/current_safezone/flight_path.json",
    "poles": "定位/mission/outputs/current_safezone/poles.json",
    "wires": "定位/mission/outputs/current_safezone/wires.ply"
  }
}
