# Local environments, maps, model weights, and generated runtime artifacts.
.venv/
env/
outputs/*
!outputs/README.md
.codegraph/
**/torch_hub_cache/
# Compiled EDM coarse-tail kernels. Regenerable (~5 s cold) and machine-specific.
執行環境/inductor_cache/
執行環境/offline_wheelhouse/
地圖檔/maps/*
!地圖檔/maps/.gitkeep
地圖檔/bundles/*
!地圖檔/bundles/.gitkeep
地圖檔/mission_routes/*
!地圖檔/mission_routes/.gitkeep
# 場域資產包：每個場域的地圖、bundle、航線與報告都是該場域私有資料，
# 只有說明文件進版控，讓 repo 記錄格式而不攜帶任何場域資料。
地圖檔/場域/*/
!地圖檔/場域/README.md
# river_site overlay: intrinsic difficult localization spheres (red) — allowed to be tracked
!地圖檔/場域/river_site/
地圖檔/場域/river_site/*
!地圖檔/場域/river_site/overlay/
!地圖檔/場域/river_site/overlay/**
定位演算法/deploy_code/runtime/EDM/weights/*
!定位演算法/deploy_code/runtime/EDM/weights/.gitignore
# 大型二進位資產：留在本機，不進 git 歷史（feature bank ~8.9GB、bundle ~2.6GB）。
執行環境/models/edm_reference_features/
執行環境/models/edm_reference_features_candidates/
# BoQ-ResNet50 檢索權重（92 MB）。RUNTIME_ARTIFACTS.json 以 SHA-256 綁定它並在
# 離線種入，不進 git 歷史。
執行環境/models/boq/
# direct 後端的執行期 scratch（placeholder manifest、EDM runtime config）。
執行環境/direct_reloc_cache/
river-localization-bundle-20260831/
river-localization-bundle-20260831.tar.zst
river-localization-bundle-20260831.tar.zst.sha256
# direct 建圖／定位交付包（tar 2.8 GB、解開後 3.1 GB）。vendor 來源與逐檔 SHA-256
# 記在 定位演算法/deploy_code/sfm_direct_deploy/VENDOR_PROVENANCE.json，
# 交付包本身留在本機。
river-deploy-5060-20260908/
river-deploy-5060-20260908.tar.zst
river-deploy-5060-20260908.tar.zst*.sha256
定位演算法/validation/report_*/
模擬器/測試影片/*
!模擬器/測試影片/README.md
# 舊模擬器封存已刪除；保留 ignore guard，避免未來封存誤進版控。
模擬器/封存/

**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cursor/
執行環境/mission_snapshots/
